# Copy to .env (never commit it) and load with `set -a; source .env; set +a`.
# Both `api` and `worker` read these from the environment.

# Local: docker run -d --name ss-pg -p 5433:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=sportsswipe postgres:16
# Production: the Tiger Cloud service URL, with ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sportsswipe

# Comma-separated emails allowed to use /v1/admin/* (lock, settle-market).
ADMIN_EMAILS=admin@sportsswipe.test

# Origin used in texted invite links (/i/{token}).
PUBLIC_BASE_URL=http://localhost:8080

# Directory with the Flutter web build that the API serves.
STATIC_DIR=../app/build/web

PORT=8080
# Set to true behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false
# Only needed when the Flutter dev server runs on a different origin.
CORS_ORIGIN=
API_DB_POOL=10
WORKER_DB_POOL=5
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports
RUST_LOG=info,sqlx=warn

# Optional, devnet only. Run the private Node service separately; never expose it directly.
COLLECTIBLES_SERVICE_URL=http://127.0.0.1:8091
# Generate with: openssl rand -hex 32; use the SAME value in API and Node service.
COLLECTIBLES_SERVICE_KEY=
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# Absolute path to the dedicated, funded devnet issuer key, never a user's wallet.
SOLANA_ISSUER_KEYPAIR=
# Admin presentation sales only: separate, funded devnet test-buyer wallet.
PRESENTATION_BUYER_KEYPAIR=

# Set true in the packaged API container to start its private Node devnet service.
COLLECTIBLES_ENABLED=false

# Analyst: Gemini plans the question; Rust computes results from DB + ESPN.
# Server-only. Never place these in Flutter defines or web assets.
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-3-flash-preview
